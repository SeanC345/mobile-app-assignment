<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/golf_cream"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
        android:id="@+id/mainTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Golf Course Finder"
        android:textAlignment="center"
        android:textColor="@color/golf_green"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/subtitleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Find and manage your favourite courses"
        android:textAlignment="center"
        android:textColor="@color/dark_text"
        android:textSize="16sp" />

    <Button
        android:id="@+id/viewCoursesButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/golf_green"
        android:text="View Courses"
        android:textColor="@color/white" />

    <Button
        android:id="@+id/addCoursebutton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/golf_green"
        android:text="Add Course"
        android:textColor="@color/white"
        android:textSize="14sp" />
</LinearLayout>