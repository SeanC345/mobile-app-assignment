<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Assignment_Mobile_App" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/golf_green</item>
        <item name="colorPrimaryVariant">@color/golf_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.Assignment_Mobile_App.Splash"
        parent="Theme.SplashScreen">

        <item name="windowSplashScreenBackground">@color/golf_cream</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_golf_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Assignment_Mobile_App</item>

    </style>
</resources>